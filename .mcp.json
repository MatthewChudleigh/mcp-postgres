{
  "mcpServers": {
    "postgres": {
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "postgres-mcp", "--access-mode", "restricted"],
      "env": {
        "POSTGRES_DATABASE_URI": "${POSTGRES_DATABASE_URI}",
        "POSTGRES_DATABASES": "${POSTGRES_DATABASES}",
        "POSTGRES_CONFIG_FILE": "${POSTGRES_CONFIG_FILE}"
      }
    }
  }
}
